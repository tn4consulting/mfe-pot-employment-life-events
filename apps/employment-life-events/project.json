{
  "name": "employment-life-events",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/employment-life-events/src",
  "tags": ["type:app", "scope:employment-life-events"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/apps/employment-life-events"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "node apps/employment-life-events/build/build.mjs",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "production": {
          "command": "node apps/employment-life-events/build/build.mjs"
        },
        "development": {
          "command": "node apps/employment-life-events/build/build.mjs --dev"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node apps/employment-life-events/build/serve.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/employment-life-events/jest.config.cts",
        "tsConfig": "apps/employment-life-events/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "employment-life-events:build",
        "staticFilePath": "dist/apps/employment-life-events/browser",
        "spa": true,
        "port": 4202
      }
    }
  }
}
